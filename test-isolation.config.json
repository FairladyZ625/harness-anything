{
  "version": 1,
  "source": {
    "exclude": ["harness", ".harness", ".harness-private", "AGENTS.md", "CLAUDE.md"]
  },
  "prepare": {
    "executable": "node",
    "args": ["tools/isolated-test-dependencies.mjs"],
    "environment": {
      "HARNESS_TEST_DEPENDENCY_CACHE": "{dependencyCacheRoot}",
      "PLAYWRIGHT_BROWSERS_PATH": "{dependencyCacheRoot}/pending/runtime/playwright",
      "ELECTRON_CACHE": "{dependencyCacheRoot}/pending/runtime/electron"
    }
  },
  "preflight": {
    "executable": "node",
    "args": ["tools/test-hermetic-preflight.mjs", "--user-root", "{stateRoot}"]
  },
  "runner": {
    "executable": "node",
    "args": ["tools/run-node-tests.mjs"],
    "environment": {
      "PLAYWRIGHT_BROWSERS_PATH": "{workspaceRoot}/.test-runtime/playwright",
      "ELECTRON_CACHE": "{workspaceRoot}/.test-runtime/electron"
    },
    "selectors": {
      "file": ["--file", "{file}"],
      "tier": {
        "fast": ["--tier", "fast"],
        "contract": ["--tier", "contract"],
        "integration": ["--tier", "integration"]
      },
      "prefix": ["--prefix", "{prefix}"],
      "coverage": ["--coverage", "{coverage}"]
    },
    "fileRoutes": [
      {
        "match": { "prefix": "packages/gui/test/", "suffix": ".vitest.ts" },
        "executable": "npm",
        "args": ["run", "test:gui", "--workspace", "@harness-anything/gui", "--"],
        "stripPrefix": "packages/gui/",
        "selector": ["{file}"]
      },
      {
        "match": { "prefix": "packages/gui/test/", "suffix": ".vitest.tsx" },
        "executable": "npm",
        "args": ["run", "test:gui", "--workspace", "@harness-anything/gui", "--"],
        "stripPrefix": "packages/gui/",
        "selector": ["{file}"]
      }
    ]
  },
  "manifest": {
    "executable": "node",
    "args": [
      "--input-type=module",
      "-e",
      "import('./tools/test-tier-manifest.mjs').then(({ discoverTestTierManifest }) => process.stdout.write(JSON.stringify(discoverTestTierManifest(process.cwd()))))"
    ]
  }
}
