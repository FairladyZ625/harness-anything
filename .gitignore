# Local-only agent entrypoints for developing this source repository.
# They route agents into .harness-private/ and must not be published.
/CLAUDE.md
/AGENTS.md
/docs/

# Phase working documents (盘点/报告):not for commit, excluded from public-text gates.
/W2D-DISPOSAL.md
/W2D-REPORT.md

# Private self-hosted Harness state. Dot-prefixed Harness directories are runtime or
# private data at any depth; the root workspace and old-generation copies are private.
.harness*/
/harness/
/harness-old-generation-*/
/.claude/
/.agents/
/.codex/
/.worktrees/
/.gstack/

node_modules/
dist/
coverage/
tmp/
*.log
*.tsbuildinfo
.playwright-mcp/

# release tarballs (npm pack output)
*.tgz
.gstack/

# Electron preload bundle (built by packages/gui build:preload)
packages/gui/dist-electron/

# Local Electron packaging outputs and downloaded runtime payloads.
packages/gui/build-resources/node/
packages/gui/build-resources/app-node_modules/
packages/gui/.runtime-cache/
