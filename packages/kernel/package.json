    "./internal/domain/todo-action-contract": "./src/domain/todo-action-contract.ts",
    "./internal/domain/task-blocking": "./src/domain/task-blocking.ts",
    "./internal/domain/task-board-projection": "./src/domain/task-board-projection.ts",
    "./internal/domain/task-lifecycle.contract": "./src/domain/task-lifecycle.contract.ts",
    "./internal/domain/task-wip-policy": "./src/domain/task-wip-policy.ts",
    "./internal/domain/workspace-summary": "./src/domain/workspace-summary.ts",
    "./internal/domain/*.ts": {
      "types": "./src/domain/*.ts",
      "default": "./src/domain/*.ts"
    },
    "./internal/integrity/*.ts": {
      "types": "./src/integrity/*.ts",
      "default": "./src/integrity/*.ts"
    },
    "./internal/layout/*.ts": {
