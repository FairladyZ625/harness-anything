      "./internal/domain/workspace-summary": "./dist/domain/workspace-summary.js",
      "./internal/domain/*.ts": {
        "types": "./dist/domain/*.d.ts",
        "default": "./dist/domain/*.js"
      },
      "./internal/integrity/*.ts": {
        "types": "./dist/integrity/*.d.ts",
        "default": "./dist/integrity/*.js"
      },
      "./internal/layout/*.ts": {
        "types": "./dist/layout/*.d.ts",
        "default": "./dist/layout/*.js"
