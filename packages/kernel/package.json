        "types": "./dist/daemon/registry.d.ts",
        "default": "./dist/daemon/registry.js"
      },
      "./internal/schemas/vertical-definition.ts": {
        "types": "./dist/schemas/vertical-definition.d.ts",
        "default": "./dist/schemas/vertical-definition.js"
      },
      "./internal/composition/receipt-acceptance.ts": {
        "types": "./dist/composition/receipt-acceptance.d.ts",
        "default": "./dist/composition/receipt-acceptance.js"
      }
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:publish": "tsc -p tsconfig.publish.json",
    "prepack": "npm run build:publish && node ../../tools/package-exports-lifecycle.mjs prepare",
    "postpack": "node ../../tools/package-exports-lifecycle.mjs restore"
  },
