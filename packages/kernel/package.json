      "./contract-version": "./dist/domain/contract-version.js",
      "./daemon-registry": "./dist/daemon/registry.js",
      "./internal/domain/closeout-readiness": "./dist/domain/closeout-readiness.js",
      "./internal/domain/decision-event": "./dist/domain/decision-event.js",
