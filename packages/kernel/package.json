{
  "name": "@harness-anything/kernel",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./contract-version": "./src/domain/contract-version.ts",
    "./daemon-registry": "./src/daemon/registry.ts",
    "./internal/*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "./contract-version": "./dist/domain/contract-version.js",
      "./daemon-registry": "./dist/daemon/registry.js",
      "./internal/*": "./dist/*.js"
    }
  },
  "dependencies": {
    "cron-parser": "5.10.0"
  }
}
