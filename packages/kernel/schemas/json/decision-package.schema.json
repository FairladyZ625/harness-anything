{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-harness-schema-id": "decision-package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "eventId", "workspaceRevision", "opId", "decisionId", "type", "actor", "source", "occurredAt", "payload"],
  "properties": {
    "schema": { "const": "decision-event/v1" },
    "eventId": { "$ref": "#/$defs/nonBlank" },
    "workspaceRevision": { "type": "integer", "minimum": 1 },
    "opId": { "$ref": "#/$defs/nonBlank" },
    "decisionId": { "type": "string", "pattern": "^dec_[A-Za-z0-9_-]+$" },
    "type": { "enum": ["decision_proposed", "decision_accepted", "decision_rejected", "decision_deferred", "decision_retired", "decision_claim_declared", "decision_claim_fulfillment_declared", "decision_related", "decision_relation_retired"] },
    "actor": { "$ref": "#/$defs/actor" },
    "source": { "$ref": "#/$defs/source" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "decision_proposed" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/proposal" } } } },
    { "if": { "properties": { "type": { "const": "decision_accepted" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/accept" } } } },
    { "if": { "properties": { "type": { "enum": ["decision_rejected", "decision_deferred", "decision_retired"] } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/reason" } } } },
    { "if": { "properties": { "type": { "const": "decision_claim_declared" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/claim" } } } },
    { "if": { "properties": { "type": { "const": "decision_claim_fulfillment_declared" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/fulfillment" } } } },
    { "if": { "properties": { "type": { "const": "decision_related" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/related" } } } },
    { "if": { "properties": { "type": { "const": "decision_relation_retired" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/relationRetired" } } } }
  ],
  "$defs": {
    "nonBlank": { "type": "string", "pattern": "\\S" },
    "short": { "type": "string", "minLength": 1, "maxLength": 199, "pattern": "\\S" },
    "actor": { "type": "object", "additionalProperties": false, "required": ["principal", "executor"], "properties": { "principal": { "type": "object", "additionalProperties": false, "required": ["personId"], "properties": { "personId": { "$ref": "#/$defs/nonBlank" } } }, "executor": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "const": "agent" }, "id": { "$ref": "#/$defs/nonBlank" } } }] } } },
    "source": { "oneOf": [{ "enum": ["local", "remote_direct"] }, { "type": "object", "additionalProperties": false, "required": ["kind", "nodeId", "assignmentId"], "properties": { "kind": { "const": "assignment" }, "nodeId": { "$ref": "#/$defs/nonBlank" }, "assignmentId": { "$ref": "#/$defs/nonBlank" } } }] },
    "applies": { "type": "object", "additionalProperties": false, "required": ["modules", "productLines"], "properties": { "modules": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonBlank" } }, "productLines": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonBlank" } } } },
    "chosen": { "type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": { "id": { "type": "string", "pattern": "^CH[A-Za-z0-9_-]+$" }, "text": { "$ref": "#/$defs/nonBlank" }, "rationale": { "$ref": "#/$defs/short" } } },
    "rejected": { "type": "object", "additionalProperties": false, "required": ["id", "text", "whyNot"], "properties": { "id": { "type": "string", "pattern": "^RJ[A-Za-z0-9_-]+$" }, "text": { "$ref": "#/$defs/nonBlank" }, "whyNot": { "$ref": "#/$defs/short" } } },
    "documentClaim": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "size", "mediaType", "policyId"], "properties": { "path": { "type": "string", "pattern": "^decisions/decision-dec_[A-Za-z0-9_-]+/decision\\.md$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "size": { "type": "integer", "minimum": 0 }, "mediaType": { "const": "text/markdown" }, "policyId": { "const": "markdown-body-replaceable/v1" } } },
    "proposal": { "type": "object", "additionalProperties": false, "required": ["title", "question", "riskTier", "urgency", "vertical", "preset", "appliesTo", "decisionClass", "chosen", "rejected", "baseDocumentSha256", "decisionDocumentClaim"], "properties": { "title": { "$ref": "#/$defs/nonBlank" }, "question": { "type": "string", "minLength": 1, "maxLength": 499 }, "riskTier": { "enum": ["low", "medium", "high"] }, "urgency": { "enum": ["low", "medium", "high"] }, "vertical": { "$ref": "#/$defs/nonBlank" }, "preset": { "$ref": "#/$defs/nonBlank" }, "appliesTo": { "$ref": "#/$defs/applies" }, "decisionClass": { "enum": ["ordinary", "standing_policy"] }, "chosen": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/chosen" } }, "rejected": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rejected" } }, "baseDocumentSha256": { "type": "null" }, "decisionDocumentClaim": { "$ref": "#/$defs/documentClaim" } } },
    "accept": { "type": "object", "additionalProperties": false, "required": ["rationale", "baseDocumentSha256", "decisionDocumentClaim"], "properties": { "rationale": { "$ref": "#/$defs/short" }, "baseDocumentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "decisionDocumentClaim": { "$ref": "#/$defs/documentClaim" } } },
    "reason": { "type": "object", "additionalProperties": false, "required": ["reason", "baseDocumentSha256", "decisionDocumentClaim"], "properties": { "reason": { "$ref": "#/$defs/short" }, "baseDocumentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "decisionDocumentClaim": { "$ref": "#/$defs/documentClaim" } } },
    "claim": { "type": "object", "additionalProperties": false, "required": ["claimId", "text", "loadBearing", "baseDocumentSha256", "decisionDocumentClaim"], "properties": { "claimId": { "type": "string", "pattern": "^C[A-Za-z0-9_-]+$" }, "text": { "$ref": "#/$defs/nonBlank" }, "loadBearing": { "type": "boolean" }, "baseDocumentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "decisionDocumentClaim": { "$ref": "#/$defs/documentClaim" } } },
    "fulfillment": { "type": "object", "additionalProperties": false, "required": ["claimId", "mode", "baseDocumentSha256", "decisionDocumentClaim"], "properties": { "claimId": { "type": "string", "pattern": "^C[A-Za-z0-9_-]+$" }, "mode": { "enum": ["evidenced", "delivered", "standing_policy"] }, "baseDocumentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "decisionDocumentClaim": { "$ref": "#/$defs/documentClaim" } } },
    "relation": { "type": "object", "additionalProperties": false, "required": ["relation_id", "source", "target", "type", "strength", "direction", "origin", "rationale", "state"], "properties": { "relation_id": { "type": "string", "pattern": "^rel_[0-9a-f]{16}$" }, "source": { "$ref": "#/$defs/nonBlank" }, "target": { "$ref": "#/$defs/nonBlank" }, "type": { "enum": ["supports", "supersedes", "refines", "narrows", "derives", "blocks", "relates", "implements", "depends-on", "produces", "evidences", "evidenced-by", "refuted-by", "invalidated-by", "supersedes-fact"] }, "strength": { "enum": ["strong", "weak"] }, "direction": { "enum": ["directed", "undirected"] }, "origin": { "enum": ["declared", "imported_snapshot", "generated", "inferred"] }, "rationale": { "$ref": "#/$defs/nonBlank" }, "state": { "const": "active" } } },
    "related": { "type": "object", "additionalProperties": false, "required": ["relation", "baseDocumentSha256", "decisionDocumentClaim"], "properties": { "relation": { "$ref": "#/$defs/relation" }, "baseDocumentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "decisionDocumentClaim": { "$ref": "#/$defs/documentClaim" } } },
    "relationRetired": { "type": "object", "additionalProperties": false, "required": ["relationId", "reason", "baseDocumentSha256", "decisionDocumentClaim"], "properties": { "relationId": { "type": "string", "pattern": "^rel_[0-9a-f]{16}$" }, "reason": { "$ref": "#/$defs/short" }, "baseDocumentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "decisionDocumentClaim": { "$ref": "#/$defs/documentClaim" } } }
  }
}
