{
  "name": "@harness-anything/daemon",
  "version": "0.0.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "default": "./src/client/index.ts"
    },
    "./protocol": {
      "default": "./src/protocol/index.ts"
    },
    "./protocol/validation": "./src/protocol/daemon-protocol-rpc-validation.ts",
    "./internal/*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@effect/experimental": "0.60.0",
    "@effect/platform": "0.96.2",
    "@effect/sql": "0.51.1",
    "@effect/sql-sqlite-node": "0.52.0",
    "@harness-anything/kernel": "0.0.1",
    "@harness-anything/preset": "0.0.1",
    "cron-parser": "5.10.0",
    "effect": "3.21.4",
    "node-pty": "1.1.0"
  },
  "homepage": "https://github.com/FairladyZ625/harness-anything#readme",
  "bugs": {
    "url": "https://github.com/FairladyZ625/harness-anything/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FairladyZ625/harness-anything.git",
    "directory": "packages/daemon"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/daemon/src/index.js",
      "./client": "./dist/daemon/src/client/index.js",
      "./protocol": "./dist/daemon/src/protocol/index.js",
      "./protocol/validation": "./dist/daemon/src/protocol/daemon-protocol-rpc-validation.js",
      "./internal/*": "./dist/daemon/src/*.js",
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "description": "Resident daemon and runtime worker host for Harness Anything.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prepare": "npm run build"
  },
  "bin": {
    "harness-anything-daemon": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ]
}
