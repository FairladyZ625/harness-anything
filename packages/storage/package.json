{
  "name": "@harness-anything/storage",
  "version": "0.0.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "homepage": "https://github.com/FairladyZ625/harness-anything#readme",
  "bugs": {
    "url": "https://github.com/FairladyZ625/harness-anything/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FairladyZ625/harness-anything.git",
    "directory": "packages/storage"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:publish": "tsc -p tsconfig.publish.json",
    "prepack": "npm run build:publish && node ../../tools/package-exports-lifecycle.mjs prepare",
    "postpack": "node ../../tools/package-exports-lifecycle.mjs restore"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@harness-anything/kernel": "0.0.1",
    "pg": "^8.23.1",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@harness-anything/authorization-keycloak": "0.0.1",
    "@types/pg": "^8.15.5"
  }
}
