{
  "name": "@harness-anything/storage",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "homepage": "https://github.com/FairladyZ625/harness-anything#readme",
  "bugs": {
    "url": "https://github.com/FairladyZ625/harness-anything/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FairladyZ625/harness-anything.git",
    "directory": "packages/storage"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./cmd-command-line": {
        "types": "./dist/store/cmd-command-line.d.ts",
        "default": "./dist/store/cmd-command-line.js"
      },
      "./sqlite": {
        "types": "./dist/sqlite/index.d.ts",
        "default": "./dist/sqlite/index.js"
      },
      "./pg": {
        "types": "./dist/postgres/index.d.ts",
        "default": "./dist/postgres/index.js"
      },
      "./pglite": {
        "types": "./dist/pglite/index.d.ts",
        "default": "./dist/pglite/index.js"
      },
      "./projection": {
        "types": "./dist/projection/index.d.ts",
        "default": "./dist/projection/index.js"
      },
      "./pglite/worker": {
        "types": "./dist/pglite/commit-worker-client.d.ts",
        "default": "./dist/pglite/commit-worker-client.js"
      }
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:publish": "tsc -p tsconfig.publish.json",
    "prepack": "npm run build:publish && node ../../tools/package-exports-lifecycle.mjs prepare",
    "postpack": "node ../../tools/package-exports-lifecycle.mjs restore"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./cmd-command-line": {
      "types": "./src/store/cmd-command-line.ts",
      "default": "./src/store/cmd-command-line.ts"
    },
    "./sqlite": {
      "types": "./src/sqlite/index.ts",
      "default": "./src/sqlite/index.ts"
    },
    "./pg": {
      "types": "./src/postgres/index.ts",
      "default": "./src/postgres/index.ts"
    },
    "./pglite": {
      "types": "./src/pglite/index.ts",
      "default": "./src/pglite/index.ts"
    },
    "./projection": {
      "types": "./src/projection/index.ts",
      "default": "./src/projection/index.ts"
    },
    "./pglite/worker": {
      "types": "./src/pglite/commit-worker-client.ts",
      "default": "./src/pglite/commit-worker-client.ts"
    }
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@harness-anything/kernel": "0.1.0",
    "pg": "^8.23.1",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@harness-anything/authorization": "0.1.0",
    "@types/pg": "^8.15.5"
  }
}
