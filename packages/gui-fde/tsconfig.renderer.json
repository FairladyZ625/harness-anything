{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx",
    "types": [],
    "outDir": "./dist/renderer-types"
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/studio/studio-api.ts"],
  "references": [{ "path": "../kernel" }, { "path": "../preset" }]
}
