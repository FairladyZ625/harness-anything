{
  "schema": "preset-manifest/v3",
  "id": "work-root",
  "title": "Collaboration Work Root",
  "vertical": "office/collab",
  "version": "1.0.0",
  "kind": "process-action",
  "outputShape": "task-package-artifact",
  "policyPath": "policy.json",
  "kernelVersionRange": { "min": "1.0.0", "maxExclusive": "2.0.0" },
  "capabilityImports": [
    { "id": "policy:artifact-contract/v1", "kind": "command", "version": "1", "required": true },
    { "id": "policy:template-override/work-plan/v1", "kind": "command", "version": "1", "required": true }
  ],
  "profiles": [
    {
      "id": "baseline",
      "title": "Baseline",
      "completionGates": [],
      "templateSelections": [
        {
          "slot": "task.plan",
          "templateRef": "template://office/work-plan@1",
          "materializeAs": "task_plan.md",
          "localePolicy": { "prefer": "project", "fallback": "en-US" }
        }
      ]
    }
  ],
  "defaultProfile": "baseline"
}
