{
  "schema": "vertical-definition/v1",
  "id": "software/coding",
  "title": "Software Coding",
  "version": "1.6.0",
  "decisions": {
    "questions": {
      "stop-reason": {
        "version": "pilot2-choice-v2",
        "type": "choice",
        "prompt": "以下文本来自一次无头软件工程派工中 worker 的收尾报告（或其中关键句）。判断这次派工的收场类别，选唯一最佳选项。文本不支持任何列出类别时选 insufficient_information。",
        "options": [
          { "id": "no_stop_completed", "text": "正常完成" },
          { "id": "environment_unavailable", "text": "环境不可用" },
          { "id": "coordination_needed", "text": "需要协调" },
          { "id": "prompt_rule_stopped", "text": "规则吓停" },
          { "id": "mixed", "text": "多因并存" },
          { "id": "other_stop", "text": "其他中途停止" },
          { "id": "unverified_empty", "text": "空报告" },
          { "id": "insufficient_information", "text": "信息不足" }
        ],
        "criteria": {
          "no_stop_completed": "当次派工正常完成：报告以任务提交或推送回执收尾。即使报告还列出不影响交付的未验证项或非阻塞的工具错误，只要交付回执在、没有挡住交付的未解决阻塞，仍属此类。",
          "environment_unavailable": "真实环境/工具/配额不可用：worker 实际尝试动作后被系统或供应商拒绝。包括：供应商错误响应或配额上限（含原始错误文本/退出码）；CI/测试设施排队、超时、未出结论或出现与本改动无关的失败；台账/发布工具报错（如推送、提交、远端分支 404）；运行期凭据拒绝。即使工作本身已做完、只是提交或验收被上述原因挡住，也属此类。",
          "coordination_needed": "需上级协调/授权/裁决：继续推进需要业主/CEO/维护者的动作，如共享面或 protected surface 的授权、超出注入授权范围、业主裁决，或等待业主提供参数、补充证据、验收材料。",
          "prompt_rule_stopped": "提示词/角色规则吓停：环境本身可用，但任务书或角色规则文本直接禁止了完成所需的动作，worker 未实际尝试即停下；典型句式是 worker 自述「按角色约束/按规则我不能做某动作」。",
          "mixed": "多因并存：同一报告同时写出环境故障与协调请求两类内容。",
          "other_stop": "运行中途截断或工作未完成：报告是进行中状态、运行被中途取消、工作自身未做完或测试仍红，且没有任何外部系统拒绝、排队或故障的描述。",
          "unverified_empty": "空报告，不可核：输入文本为空，无从判断。",
          "insufficient_information": "信息不足：文本存在但不支持上述任何类别。"
        },
        "abstainOptionId": "insufficient_information"
      },
      "runtime-incident-disposition": {
        "version": "runtime-incident-disposition/v1",
        "type": "choice",
        "prompt": "以下结构化输入来自一次无头派工结算后的事故证据（结局分类、worker 收尾报告与最后结论、工具调用数、worktree HEAD 对比、任务已用轮次与返工预算）。为一个运行事故选择唯一处置动作。不确定、证据缺失、预算耗尽或动作前提不成立时选 needs_attention；不得凭模型自称完成代替台账证据。",
        "options": [
          { "id": "resume_original", "text": "续跑原会话" },
          { "id": "rerun_same_identity", "text": "同身份新会话重跑" },
          { "id": "switch_declared_next", "text": "换声明的下一个身份或 runtime" },
          { "id": "needs_attention", "text": "升级 CEO" },
          { "id": "no_action", "text": "不处理" }
        ],
        "criteria": {
          "resume_original": "事故未显示已提交；原 dispatch 存在可恢复的 provider session；worktree 仍与任务绑定且 HEAD 状态已知；预算尚未耗尽。续跑沿用原会话上下文，损失最小。",
          "rerun_same_identity": "仍需自动推进，但原 session 不可恢复或无 provider session；原身份与 runtime 仍可用；worktree 未被其他 execution 占用；预算尚未耗尽。新会话会收到上一轮结论与 HEAD 对比上下文。",
          "switch_declared_next": "分类是 provider_fault/provider_quota，或当前身份明确不可用；声明顺序存在下一个可用 candidate 且满足模型/权限契约。worker_stop 类事故不得选此项。",
          "needs_attention": "输入不完整、provider 弃权、预算耗尽、无可用 candidate、worktree 被占用、事故与选项不匹配，或任何动作前提不确定。把任务升级给业主，不猜测重跑。",
          "no_action": "仅当台账证据显示该任务已提交（submission 已被接受）或该 dispatch 已有 successor/正在跑的 execution。模型或 worker 自称完成不构成证据。"
        },
        "abstainOptionId": "needs_attention"
      }
    },
    "points": {
      "dispatch-stop-reason": {
        "revision": "2",
        "on": "dispatch.settled",
        "when": {
          "outcome": ["failed", "cancelled", "succeeded", "stopped"],
          "classification": ["worker_stop", "gate_red", "awaiting_ruling"]
        },
        "input": ["report.body", "dispatch.reason", "dispatch.classification"],
        "question": "stop-reason",
        "show": ["task.dispatches"]
      },
      "runtime-incident-worker-stop": {
        "revision": "1",
        "on": "dispatch.settled",
        "when": {
          "outcome": ["stopped", "failed"],
          "classification": ["worker_stop"]
        },
        "input": [
          "dispatch.classification",
          "dispatch.reason",
          "runtime.toolCallCount",
          "runtime.headStatus",
          "runtime.lastConclusion",
          "runtime.exitHead",
          "runtime.currentHead",
          "task.roundsUsed",
          "task.reworkBudget",
          "report.body"
        ],
        "question": "runtime-incident-disposition",
        "show": ["task.dispatches", "agenda"]
      }
    }
  },
  "entityFieldExtensions": [
    {
      "extends": "task",
      "field": "taskClass",
      "kind": "enum-facet",
      "values": ["work"],
      "default": null,
      "mutability": "amendable",
      "projection": { "column": "task_class", "queryable": true },
      "reason": "Software delivery planning declares a work root: the task whose subtree is one body of work."
    }
  ],
