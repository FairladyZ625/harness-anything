{
  "schema": "preset-manifest/v3",
  "id": "standard-task",
  "title": "Standard Task",
  "vertical": "software/coding",
  "version": "3.0.0",
  "kind": "template-content",
  "outputShape": "repository-diff",
  "kernelVersionRange": { "min": "1.0.0", "maxExclusive": "2.0.0" },
  "capabilityImports": [{ "id": "standard-task-check", "kind": "checker", "version": "1", "required": false }],
  "profiles": [
    { "id": "baseline", "title": "Baseline", "checkerProfile": "standard", "completionGates": ["ci", "code-doc-reconciliation"], "templateSelections": [] },
    {
      "id": "lightweight",
      "title": "Lightweight",
      "checkerProfile": "standard",
      "completionGates": [],
      "capabilityImports": [
        { "id": "policy:template-override/lightweight-task-plan/v1", "kind": "command", "version": "1" },
        { "id": "policy:template-override/lightweight-closeout/v1", "kind": "command", "version": "1" }
      ],
      "templateSelections": [
        {
          "slot": "task.plan",
          "templateRef": "template://planning/task-plan-lightweight@1",
          "materializeAs": "task_plan.md",
          "localePolicy": { "prefer": "project", "fallback": "en-US" }
        },
        {
          "slot": "task.closeout",
          "templateRef": "template://planning/closeout-lightweight@1",
          "materializeAs": "closeout.md",
          "localePolicy": { "prefer": "project", "fallback": "en-US" }
        }
      ],
      "closeoutOverrides": { "review": false, "consent": false, "fact": false },
      "archiveOnComplete": true
    }
  ],
  "defaultProfile": "baseline"
}
