{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "typeRoots": ["./types", "../../node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
}
