{
  "name": "@harness-anything/authorization-builtin",
  "version": "0.1.0",
  "description": "Single-machine built-in authorization, RBAC and local session adapters for Harness Anything.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "homepage": "https://github.com/FairladyZ625/harness-anything#readme",
  "bugs": {"url": "https://github.com/FairladyZ625/harness-anything/issues"},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FairladyZ625/harness-anything.git",
    "directory": "packages/authorization-builtin"
  },
  "files": ["dist", "README.md", "package.json"],
  "engines": {"node": ">=24"},
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./internal/state": "./dist/state.js"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./internal/state": "./src/state.ts"
  },
  "scripts": {
    "build:publish": "tsc -p tsconfig.publish.json",
    "prepack": "npm run build:publish && node ../../tools/package-exports-lifecycle.mjs prepare",
    "postpack": "node ../../tools/package-exports-lifecycle.mjs restore"
  },
  "dependencies": {"@harness-anything/kernel": "0.1.0"}
}
